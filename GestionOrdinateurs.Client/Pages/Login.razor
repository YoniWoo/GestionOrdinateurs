@page "/login"

@inject NavigationManager Navigation

<PageTitle>Connexion</PageTitle>

<h3>Connexion</h3>

<p>Connectez-vous avec votre compte Keycloak.</p>

<button class="btn btn-primary" @onclick="Connecter">
    Se connecter
</button>

@code {
    private void Connecter()
    {
        Navigation.NavigateToLogin("authentication/login");
    }
}